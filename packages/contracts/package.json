{
  "name": "@seapass/contracts",
  "private": true,
  "version": "0.1.0",
  "description": "Schemas Zod e tipos TypeScript compartilhados entre apps/web e apps/api (contrato da API)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@seapass/config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
