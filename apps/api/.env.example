# apps/api — copiar para ".env" dentro de apps/api para desenvolvimento local
# Validado em runtime por src/config (schema Zod) — a API nao sobe se algo obrigatorio faltar.

NODE_ENV=development
PORT=3333

# --- Database ---
DATABASE_URL=postgresql://seapass:seapass@localhost:5432/seapass?schema=public

# --- Redis (cache, hold de cabine, filas BullMQ) ---
REDIS_URL=redis://localhost:6379
CABIN_HOLD_MINUTES=15

# --- Auth (JWT) ---
# Precisam ter 32+ caracteres e serem DIFERENTES um do outro — a API recusa subir caso
# contrario (ver src/config/env.schema.ts). Gere segredos reais com, por exemplo,
# `openssl rand -base64 32` — nunca reuse os valores de exemplo abaixo em produção.
JWT_ACCESS_SECRET=change-me-access-please-use-32-chars-or-more
JWT_REFRESH_SECRET=change-me-refresh-please-use-32-chars-or-more
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage (S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=seapass
STORAGE_SECRET_KEY=seapass123
STORAGE_BUCKET=seapass-media

# --- Observabilidade ---
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- CORS ---
WEB_APP_URL=http://localhost:3000

# --- E-mail (notificacoes, ver ADR-0019) ---
# Em dev, aponta pro MailHog local (SMTP :1025, UI web em http://localhost:8025) — nao precisa
# de credencial real, MailHog aceita qualquer coisa e nunca entrega de verdade.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SeaPass <no-reply@seapass.com>
BOARDING_REMINDER_HOURS_BEFORE=24
