# apps/api — copiar para ".env" dentro de apps/api para desenvolvimento local
# Validado em runtime por src/config (schema Zod) — a API nao sobe se algo obrigatorio faltar.

NODE_ENV=development
PORT=3333

# --- Database ---
DATABASE_URL=postgresql://seapass:seapass@localhost:5432/seapass?schema=public

# --- Redis (cache, hold de cabine, filas BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage (S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=seapass
STORAGE_SECRET_KEY=seapass123
STORAGE_BUCKET=seapass-media

# --- Observabilidade ---
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- CORS ---
WEB_APP_URL=http://localhost:3000
