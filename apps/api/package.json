{
  "name": "@seapass/api",
  "private": true,
  "version": "0.1.0",
  "description": "SeaPass — backend NestJS (API REST, regras de negocio, jobs assincronos)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.unit.config.ts",
    "test:integration": "jest --config jest.integration.config.ts",
    "db:migrate": "prisma migrate deploy --schema src/database/prisma/schema.prisma",
    "db:seed": "ts-node src/database/prisma/seed.ts"
  },
  "dependencies": {
    "@seapass/contracts": "workspace:*"
  },
  "devDependencies": {
    "@seapass/config": "workspace:*",
    "typescript": "^5.6.0"
  }
}
