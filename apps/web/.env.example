# apps/web — copiar para ".env.local" dentro de apps/web para desenvolvimento local
# Prefixo NEXT_PUBLIC_ = exposto ao browser. Sem o prefixo = server-only (Route Handlers/SSR).

NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_SENTRY_DSN=

# Server-only (usado em server actions / route handlers, nunca exposto ao client)
API_INTERNAL_URL=http://localhost:3333
