{
  "name": "@seapass/web",
  "private": true,
  "version": "0.1.0",
  "description": "SeaPass — frontend Next.js (site publico, area do passageiro, painel do organizador, painel admin)",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/apps/web/server.js",
