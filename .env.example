# Variaveis compartilhadas pelo docker-compose (infra/docker-compose.yml)
# Copie para ".env" na raiz para uso local. Nunca commitar o .env real.

# --- Postgres ---
POSTGRES_USER=seapass
POSTGRES_PASSWORD=seapass
POSTGRES_DB=seapass
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Portas expostas das apps ---
WEB_PORT=3000
API_PORT=3333

# --- MailHog (SMTP de mentira para inspecionar as notificacoes por e-mail, ver ADR-0019) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
