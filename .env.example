# Variaveis compartilhadas pelo docker-compose (infra/docker-compose.yml)
# Copie para ".env" na raiz para uso local. Nunca commitar o .env real.

# --- Postgres ---
POSTGRES_USER=seapass
POSTGRES_PASSWORD=seapass
POSTGRES_DB=seapass
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO (S3-compatible, storage local de desenvolvimento) ---
MINIO_ROOT_USER=seapass
MINIO_ROOT_PASSWORD=seapass123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=seapass-media

# --- Portas expostas das apps ---
WEB_PORT=3000
API_PORT=3333
