# node-linker=hoisted evita a estrutura de node_modules baseada em symlinks do pnpm
# para pacotes de terceiros. Necessario porque `next build` (output "standalone") tenta
# recriar symlinks ao copiar o node_modules traçado, o que falha com EPERM no Windows
# sem privilegio elevado ou "Developer Mode" habilitado. Pacotes do proprio workspace
# (@seapass/*) continuam linkados normalmente — isso nao afeta o isolamento entre eles.
node-linker=hoisted
